# SendGrid Mail Send API key. Never expose in browser code or commit real values.
SENDGRID_API_KEY=
# Exact authenticated Accountexec sender address, validated by SendGrid.
LEADS_FROM_EMAIL=
LEADS_FROM_NAME=Red Spectrum WebFactory
# Exact authorized internal inbox. Used only when a customer's server-side mode is test.
LEADS_TEST_TO_EMAIL=
# Persistent PostgreSQL connection string; no local or in-memory fallback exists.
LEADS_DATABASE_URL=
# Random server-only salt used to hash rate-limit keys.
LEADS_RATE_LIMIT_SALT=
# Server-only bearer secret for manual GET/POST retry calls.
LEADS_RETRY_CRON_SECRET=
# Vercel Cron sends this value as a Bearer token; set it equal to LEADS_RETRY_CRON_SECRET.
CRON_SECRET=

# RS WebFactory admin: set strong values before deployment. Never use local test credentials in production.
WEBFACTORY_ADMIN_USER=
WEBFACTORY_ADMIN_PASSWORD=
WEBFACTORY_SESSION_SECRET=
# Internal notification requires explicit enabling after sender and inbox confirmation.
WEBFACTORY_REQUEST_NOTIFY_EMAIL=
WEBFACTORY_INTERNAL_NOTIFICATIONS_ENABLED=false
WEBFACTORY_CUSTOMER_EMAILS_ENABLED=false
# Optional per-customer allowlists (comma-separated slugs). When set, they additionally restrict the flags above to
# just the listed customers in that mode, so turning a flag on for one newly-activated customer never activates
# another customer's already-configured test/live delivery. Leave unset to keep today's global-only behavior.
WEBFACTORY_LEAD_TEST_ACTIVE_SLUGS=
WEBFACTORY_LEAD_LIVE_ACTIVE_SLUGS=
# Reserved integration placeholders; no customer lookup is performed yet.
CUSTOMER_INTELLIGENCE_API_URL=
CUSTOMER_INTELLIGENCE_API_KEY=

# Server-only AI draft generation. Never use NEXT_PUBLIC_ for this key.
OPENAI_API_KEY=
WEBFACTORY_AI_MODEL=gpt-4.1-mini
# Controlled build worker (disabled until a separately supervised Windows/Node 24 worker exists).
WEBFACTORY_BUILD_EXECUTOR=
WEBFACTORY_BUILD_WORKER_SECRET=
WEBFACTORY_BUILD_CONTROL_URL=
WEBFACTORY_BUILD_ROOT=
WEBFACTORY_BUILD_BASE_SHA=
GH_TOKEN=
VERCEL_TOKEN=
AGENT_BROWSER_CLI=

# Optional discovered Windows tooling (no secrets).
VERCEL_CLI=
AGENT_BROWSER_EXECUTABLE_PATH=
